<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.UserProfileMapper">
    <resultMap id="BaseResultMap" type="com.hnit.system.domain.UserProfile">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="bio" property="bio"/>
        <result column="real_name" property="realName"/>
        <result column="gender" property="gender"/>
        <result column="birthday" property="birthday"/>
        <result column="location" property="location"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO user_profile (id, user_id, bio, real_name, gender, birthday, location, create_time, update_time)
        VALUES (#{id}, #{userId}, #{bio}, #{realName}, #{gender}, #{birthday}, #{location}, NOW(), NOW())
    </insert>

    <update id="updateByUserId">
        UPDATE user_profile
        SET bio = #{bio}, real_name = #{realName}, gender = #{gender},
            birthday = #{birthday}, location = #{location}, update_time = NOW()
        WHERE user_id = #{userId}
    </update>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM user_profile WHERE user_id = #{userId}
    </select>

    <delete id="deleteByUserId">
        DELETE FROM user_profile WHERE user_id = #{userId}
    </delete>
</mapper>