<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.ShoppingCartMapper">
    <resultMap id="BaseResultMap" type="com.hnit.system.domain.ShoppingCart">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="item_type" property="itemType"/>
        <result column="item_id" property="itemId"/>
        <result column="quantity" property="quantity"/>
        <result column="added_time" property="addedTime"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO shopping_cart (id, user_id, item_type, item_id, quantity, added_time)
        VALUES (#{id}, #{userId}, #{itemType}, #{itemId}, #{quantity}, NOW())
    </insert>

    <update id="updateQuantity">
        UPDATE shopping_cart SET quantity = #{quantity} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM shopping_cart WHERE id = #{id}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM shopping_cart WHERE user_id = #{userId}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM shopping_cart WHERE id = #{id}
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM shopping_cart WHERE user_id = #{userId} ORDER BY added_time DESC
    </select>

    <select id="selectByUserAndItem" resultMap="BaseResultMap">
        SELECT * FROM shopping_cart
        WHERE user_id = #{userId} AND item_type = #{itemType} AND item_id = #{itemId}
    </select>
</mapper>