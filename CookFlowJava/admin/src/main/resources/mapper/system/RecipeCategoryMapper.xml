<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.RecipeCategoryMapper">

    <resultMap id="RecipeCategoryResult" type="com.hnit.system.domain.RecipeCategory">
        <id property="id" column="id"/>
        <result property="recipeId" column="recipe_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        , recipe_id, category_id, create_time
    </sql>

    <select id="selectByRecipeId" resultMap="RecipeCategoryResult">
        SELECT
        <include refid="Base_Column_List"/>
        FROM recipe_category
        WHERE recipe_id = #{recipeId}
    </select>

    <select id="selectByCategoryId" resultMap="RecipeCategoryResult">
        SELECT
        <include refid="Base_Column_List"/>
        FROM recipe_category
        WHERE category_id = #{categoryId}
    </select>

    <insert id="insert" parameterType="com.hnit.system.domain.RecipeCategory">
        INSERT INTO recipe_category (id, recipe_id, category_id, create_time)
        VALUES (#{id}, #{recipeId}, #{categoryId}, #{createTime})
    </insert>

    <insert id="batchInsert" parameterType="list">
        INSERT INTO recipe_category (id, recipe_id, category_id, create_time)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.recipeId}, #{item.categoryId}, #{item.createTime})
        </foreach>
    </insert>

    <delete id="deleteByRecipeId">
        DELETE
        FROM recipe_category
        WHERE recipe_id = #{recipeId}
    </delete>

    <delete id="deleteByCategoryId">
        DELETE
        FROM recipe_category
        WHERE category_id = #{categoryId}
    </delete>

    <delete id="deleteByRecipeAndCategory">
        DELETE
        FROM recipe_category
        WHERE recipe_id = #{recipeId}
          AND category_id = #{categoryId}
    </delete>
</mapper>