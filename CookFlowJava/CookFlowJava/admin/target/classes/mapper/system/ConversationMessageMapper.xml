<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.ConversationMessageMapper">
    <resultMap id="BaseResultMap" type="com.hnit.system.domain.ConversationMessage">
        <id column="id" property="id"/>
        <result column="session_id" property="sessionId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="timestamp" property="timestamp"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO conversation_message (session_id, role, content, timestamp)
        VALUES (#{sessionId}, #{role}, #{content}, NOW())
    </insert>

    <select id="selectRecentBySessionId" resultMap="BaseResultMap">
        SELECT *
        FROM conversation_message
        WHERE session_id = #{sessionId}
        ORDER BY timestamp DESC
            LIMIT #{limit}
    </select>
</mapper>