<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.RecipeIngredientsMapper">
    <resultMap type="com.hnit.system.domain.RecipeIngredients" id="RecipeIngredientsResult">
        <id property="id" column="id"/>
        <result property="recipeId" column="recipe_id"/>
        <result property="categoryId" column="category_id"/>
        <result property="amount" column="amount"/>
        <result property="unit" column="unit"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        , recipe_id, category_id, amount, unit
    </sql>

    <select id="selectRecipeIngredientsList" parameterType="com.hnit.system.domain.RecipeIngredients"
            resultMap="RecipeIngredientsResult">
        SELECT
        <include refid="Base_Column_List"/>
        FROM recipe_ingredients
        <where>
            <if test="recipeId != null and recipeId != ''">and recipe_id = #{recipeId}</if>
            <if test="categoryId != null and categoryId != ''">and category_id = #{categoryId}</if>
        </where>
    </select>

    <select id="selectRecipeIngredientsByRecipeId" parameterType="String" resultMap="RecipeIngredientsResult">
        SELECT
        <include refid="Base_Column_List"/>
        FROM recipe_ingredients
        WHERE recipe_id = #{recipeId}
    </select>

    <insert id="insertRecipeIngredients" parameterType="com.hnit.system.domain.RecipeIngredients">
        INSERT INTO recipe_ingredients (id, recipe_id, category_id, amount, unit)
        VALUES (#{id}, #{recipeId}, #{categoryId}, #{amount}, #{unit})
    </insert>

    <update id="updateRecipeIngredients" parameterType="com.hnit.system.domain.RecipeIngredients">
        UPDATE recipe_ingredients
        <set>
            <if test="amount != null">amount = #{amount},</if>
            <if test="unit != null">unit = #{unit},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteRecipeIngredientsByRecipeIds" parameterType="String">
        DELETE FROM recipe_ingredients WHERE recipe_id IN
        <foreach item="recipeId" collection="array" open="(" separator="," close=")">
            #{recipeId}
        </foreach>
    </delete>

    <delete id="deleteRecipeIngredientById" parameterType="String">
        DELETE
        FROM recipe_ingredients
        WHERE id = #{id}
    </delete>
</mapper>