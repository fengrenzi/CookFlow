<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.FavoritesMapper">
    
    <resultMap type="Favorites" id="FavoritesResult">
        <result property="userId"    column="user_id"    />
        <result property="recipeId"    column="recipe_id"    />
        <result property="createdAt"    column="created_at"    />
    </resultMap>

    <sql id="selectFavoritesVo">
        select user_id, recipe_id, created_at from favorites
    </sql>

    <select id="selectFavoritesList" parameterType="Favorites" resultMap="FavoritesResult">
        <include refid="selectFavoritesVo"/>
        <where>  
            <if test="createdAt != null "> and created_at = #{createdAt}</if>
        </where>
    </select>
    
    <select id="selectFavoritesByUserId" parameterType="Long" resultMap="FavoritesResult">
        <include refid="selectFavoritesVo"/>
        where user_id = #{userId}
    </select>

    <insert id="insertFavorites" parameterType="Favorites">
        insert into favorites
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="recipeId != null">recipe_id,</if>
            <if test="createdAt != null">created_at,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="recipeId != null">#{recipeId},</if>
            <if test="createdAt != null">#{createdAt},</if>
         </trim>
    </insert>

    <update id="updateFavorites" parameterType="Favorites">
        update favorites
        <trim prefix="SET" suffixOverrides=",">
            <if test="recipeId != null">recipe_id = #{recipeId},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
        </trim>
        where user_id = #{userId}
    </update>

    <delete id="deleteFavoritesByUserId" parameterType="Long">
        delete from favorites where user_id = #{userId}
    </delete>

    <delete id="deleteFavoritesByUserIds" parameterType="String">
        delete from favorites where user_id in 
        <foreach item="userId" collection="array" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>
</mapper>