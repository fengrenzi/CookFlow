<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.RecipeIngredientsMapper">
    
    <resultMap type="RecipeIngredients" id="RecipeIngredientsResult">
        <result property="recipeId"    column="recipe_id"    />
        <result property="ingredientId"    column="ingredient_id"    />
        <result property="amount"    column="amount"    />
        <result property="unit"    column="unit"    />
    </resultMap>

    <sql id="selectRecipeIngredientsVo">
        select recipe_id, ingredient_id, amount, unit from recipe_ingredients
    </sql>

    <select id="selectRecipeIngredientsList" parameterType="RecipeIngredients" resultMap="RecipeIngredientsResult">
        <include refid="selectRecipeIngredientsVo"/>
        <where>  
            <if test="amount != null "> and amount = #{amount}</if>
            <if test="unit != null  and unit != ''"> and unit = #{unit}</if>
        </where>
    </select>
    
    <select id="selectRecipeIngredientsByRecipeId" parameterType="Long" resultMap="RecipeIngredientsResult">
        <include refid="selectRecipeIngredientsVo"/>
        where recipe_id = #{recipeId}
    </select>

    <insert id="insertRecipeIngredients" parameterType="RecipeIngredients">
        insert into recipe_ingredients
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recipeId != null">recipe_id,</if>
            <if test="ingredientId != null">ingredient_id,</if>
            <if test="amount != null">amount,</if>
            <if test="unit != null">unit,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recipeId != null">#{recipeId},</if>
            <if test="ingredientId != null">#{ingredientId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="unit != null">#{unit},</if>
         </trim>
    </insert>

    <update id="updateRecipeIngredients" parameterType="RecipeIngredients">
        update recipe_ingredients
        <trim prefix="SET" suffixOverrides=",">
            <if test="ingredientId != null">ingredient_id = #{ingredientId},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="unit != null">unit = #{unit},</if>
        </trim>
        where recipe_id = #{recipeId}
    </update>

    <delete id="deleteRecipeIngredientsByRecipeId" parameterType="Long">
        delete from recipe_ingredients where recipe_id = #{recipeId}
    </delete>

    <delete id="deleteRecipeIngredientsByRecipeIds" parameterType="String">
        delete from recipe_ingredients where recipe_id in 
        <foreach item="recipeId" collection="array" open="(" separator="," close=")">
            #{recipeId}
        </foreach>
    </delete>
</mapper>