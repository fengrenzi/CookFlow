<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.ResourceTagMapper">

    <resultMap id="BaseResultMap" type="ResourceTag">
        <result column="resource_type" property="resourceType"/>
        <result column="resource_id" property="resourceId"/>
        <result column="tag_id" property="tagId"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="ResourceTag">
        INSERT INTO resource_tags (resource_type, resource_id, tag_id, created_at)
        VALUES (#{resourceType}, #{resourceId}, #{tagId}, #{createdAt})
    </insert>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT * FROM resource_tags
        WHERE resource_type = #{resourceType}
          AND resource_id = #{resourceId}
    </select>
</mapper>