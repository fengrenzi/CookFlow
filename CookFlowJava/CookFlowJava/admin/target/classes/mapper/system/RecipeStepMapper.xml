<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.RecipeStepMapper">
    <resultMap id="BaseResultMap" type="com.hnit.system.domain.RecipeStep">
        <id column="id" property="id"/>
        <result column="recipe_id" property="recipeId"/>
        <result column="step_number" property="stepNumber"/>
        <result column="description" property="description"/>
        <result column="image_id" property="imageId"/>
        <result column="duration_minutes" property="durationMinutes"/>
        <result column="tips" property="tips"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByRecipeId" resultMap="BaseResultMap">
        SELECT *
        FROM recipe_steps
        WHERE recipe_id = #{recipeId}
        ORDER BY step_number
    </select>
</mapper>