<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.ActivitySuggestionsMapper">
    <resultMap id="BaseResultMap" type="com.hnit.system.domain.ActivitySuggestions">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert">
        INSERT INTO activity_suggestions (id, user_id, title, content, status, create_time)
        VALUES (#{id}, #{userId}, #{title}, #{content}, #{status}, NOW())
    </insert>

    <update id="updateStatus">
        UPDATE activity_suggestions SET status = #{status} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM activity_suggestions WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM activity_suggestions WHERE id = #{id}
    </select>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT * FROM activity_suggestions WHERE status = #{status} ORDER BY create_time DESC
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM activity_suggestions WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>
</mapper>