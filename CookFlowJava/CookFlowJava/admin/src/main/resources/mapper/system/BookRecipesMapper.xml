<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.BookRecipesMapper">

    <resultMap id="BaseResultMap" type="com.hnit.system.domain.BookRecipe">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="book_id" property="bookId" jdbcType="VARCHAR"/>
        <result column="recipe_id" property="recipeId" jdbcType="VARCHAR"/>
        <result column="page_number" property="pageNumber" jdbcType="INTEGER"/>
        <result column="sort_order" property="sortOrder" jdbcType="INTEGER"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, book_id, recipe_id, page_number, sort_order, created_at
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM book_recipes
        WHERE id = #{id}
    </select>

    <select id="selectByBookId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM book_recipes
        WHERE book_id = #{bookId}
        ORDER BY page_number ASC, sort_order ASC
    </select>

    <select id="selectByRecipeId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM book_recipes
        WHERE recipe_id = #{recipeId}
    </select>

    <insert id="insert" parameterType="com.hnit.system.domain.BookRecipe" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book_recipes (book_id, recipe_id, page_number, sort_order, created_at)
        VALUES (#{bookId}, #{recipeId}, #{pageNumber}, #{sortOrder}, NOW())
    </insert>

    <update id="update" parameterType="com.hnit.system.domain.BookRecipe">
        UPDATE book_recipes
        SET page_number = #{pageNumber},
            sort_order = #{sortOrder}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM book_recipes WHERE id = #{id}
    </delete>
</mapper>