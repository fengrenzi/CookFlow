<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hnit.system.mapper.BookMapper">

    <resultMap id="BookVOMap" type="BookVo">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="author" property="author"/>
        <result column="publisher" property="publisher"/>
        <result column="price" property="price"/>
        <result column="cover_image_id" property="coverImageId"/>
        <result column="description" property="description"/>
        <result column="total_pages" property="totalPages"/>
        <result column="recipe_count" property="recipeCount"/>
        <result column="status" property="status"/>
        <result column="difficulty" property="difficulty"/>
        <result column="read_count" property="readCount"/>
        <result column="recommend_count" property="recommendCount"/>
        <result column="reading_count" property="readingCount"/>
        <result column="sales_count" property="salesCount"/>
        <result column="rating_score" property="ratingScore"/>
        <result column="rating_people" property="ratingPeople"/>
    </resultMap>

    <select id="selectById" resultMap="BookVOMap">
        SELECT *
        FROM books
        WHERE id = #{id}
    </select>

    <select id="selectPage" resultMap="BookVOMap">
        SELECT *
        FROM books
        <where>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="author != null and author != ''">
                AND author LIKE CONCAT('%', #{author}, '%')
            </if>
            <if test="difficulty != null">
                AND difficulty = #{difficulty}
            </if>
            <if test="minRating != null">
                AND IFNULL(rating_score, 0) >= #{minRating}
            </if>
            <if test="minPrice != null">
                AND price >= #{minPrice}
            </if>
            <if test="maxPrice != null">
                AND price &lt;= #{maxPrice}
            </if>
            AND status = 0
        </where>
        <choose>
            <when test="sortBy == 'price_asc'">
                ORDER BY price ASC
            </when>
            <when test="sortBy == 'price_desc'">
                ORDER BY price DESC
            </when>
            <when test="sortBy == 'newest'">
                ORDER BY created_at DESC
            </when>
            <when test="sortBy == 'recommended'">
                ORDER BY (sales_count * 0.5 + rating_score * 0.5) DESC
            </when>
            <when test="sortBy == 'reading_count_desc'">
                ORDER BY reading_count DESC
            </when>
            <when test="sortBy == 'rating_desc'">
                ORDER BY rating_score DESC
            </when>
            <otherwise>
                ORDER BY created_at DESC
            </otherwise>
        </choose>
    </select>

    <select id="countPage" resultType="int">
        SELECT COUNT(*)
        FROM books
        <where>
            <if test="title != null and title != ''">
                AND title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="author != null and author != ''">
                AND author LIKE CONCAT('%', #{author}, '%')
            </if>
            <if test="difficulty != null">
                AND difficulty = #{difficulty}
            </if>
            <if test="minRating != null">
                AND IFNULL(rating_score, 0) >= #{minRating}
            </if>
            <if test="minPrice != null">
                AND price >= #{minPrice}
            </if>
            <if test="maxPrice != null">
                AND price &lt;= #{maxPrice}
            </if>
            AND status = 0
        </where>
    </select>

    <!-- 根据用户ID查询发布的书籍 -->
    <select id="selectByUserId" resultType="com.hnit.system.domain.Books">
        SELECT * FROM books WHERE created_by = #{userId} ORDER BY created_at DESC
    </select>

    <!-- 根据ID列表批量查询 -->
    <select id="selectByIds" resultType="com.hnit.system.domain.Books">
        SELECT * FROM books WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>